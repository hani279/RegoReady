# Leave everything blank to run in demo mode: reports are issued without
# payment, use sample vehicle data, and are stored in .data/reports.json.

# Stripe: payment for the $19 report. Use sk_test_... keys while testing.
STRIPE_SECRET_KEY=
# From the webhook endpoint for /api/stripe/webhook (checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# Register search provider: "mock" (sample data) or "businessapi".
PPSR_PROVIDER=mock
# Business API secret key. bapi_sk_test_... uses the free sandbox,
# bapi_sk_live_... runs real searches at $6.00 each.
BUSINESSAPI_KEY=

# Plate search: turns an NSW plate into a VIN before the register search.
# "regcheck" uses carregistrationapi.com.au and needs its account username
# ($0.30 a lookup). Leave PLATE_PROVIDER blank for VIN-only with a real
# register provider.
PLATE_PROVIDER=
REGCHECK_USERNAME=

# Supabase: report storage (run supabase/migrations first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, used for the sitemap
NEXT_PUBLIC_SITE_URL=
